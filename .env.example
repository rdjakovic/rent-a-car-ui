# API Configuration
# Leave empty: `pnpm dev` and `pnpm preview` forward /api to the backend
# (API_PROXY_TARGET, default http://localhost:8080), so the app has a single origin.
# Set it only to call an API on another host directly (that backend must allow the origin).
VITE_API_BASE_URL=

# Development Configuration
# Set to 'true' to enable MSW (Mock Service Worker) for offline development
VITE_ENABLE_MOCKING=false
